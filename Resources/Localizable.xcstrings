          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht {\"boards\": [{\"file\", \"row\", \"title\", \"w\", \"h\"}]}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es {\"boards\": [{\"file\", \"row\", \"title\", \"w\", \"h\"}]}."
