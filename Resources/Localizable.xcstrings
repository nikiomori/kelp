          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellung „%@“: Kelp kennt die Darstellung „%@“ nicht, daher wird sie als Menü angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
