        }
      }
    },
    "A notification when a plan limit reaches this, and again at 95. “off”: none.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление, когда лимит плана дойдёт до этого числа, и ещё раз на 95. «off» — без уведомлений."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, wenn ein Tariflimit diesen Wert erreicht, und erneut bei 95. „off“: keine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación cuando un límite del plan llega a esto, y otra a 95. «off»: ninguna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランの制限がこの値に達したとき、および95で通知します。「off」：通知しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套餐限额达到此值时通知，95 时再次通知。“off”：不通知。"
          }
        }
      }
    },
    "A symbol’s signature and documentation, and the arguments of a call as you type it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнатура и документация символа, а также аргументы вызова при наборе."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signatur und Dokumentation eines Symbols sowie die Argumente eines Aufrufs beim Tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma y la documentación de un símbolo, y los argumentos de una llamada mientras la escribes."
          }
        },
        "ja": {
