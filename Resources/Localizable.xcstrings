    "%@ keeps no passwords Kelp can read: each is asked when first used": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не хранит паролей, которые Kelp может прочитать: каждый спросят при первом открытии"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speichert keine Passwörter, die Kelp lesen kann: Jedes wird bei der ersten Verwendung abgefragt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no guarda contraseñas que Kelp pueda leer: cada una se pide al usarla por primera vez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはKelpが読み取れるパスワードがありません。それぞれ最初に使うときに確認します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不保存 Kelp 可读取的密码：每个密码在首次使用时询问"
          }
        }
      }
    },
