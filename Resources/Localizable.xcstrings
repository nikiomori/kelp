          "stringUnit": {
            "state": "translated",
            "value": "%@の新しいターミナルとエージェントは、そのdev containerで起動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的新终端和智能体在其开发容器中启动。"
          }
        }
      }
    },
    "Its database copy %@ goes too.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия базы %@ тоже удалится."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Datenbankkopie %@ wird ebenfalls entfernt."
          }
        },
        "es": {
