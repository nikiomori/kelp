    "Stop the task’s agent too?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить и агента задачи?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch den Agenten der Aufgabe stoppen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Detener también el agente de la tarea?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクのエージェントも停止しますか?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也停止该任务的智能体吗?"
          }
        }
      }
    },
    "The task is cancelled either way. Conversations can be resumed from Session History.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача отменится в любом случае. Разговоры можно продолжить из истории сессий."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wird so oder so abgebrochen. Unterhaltungen lassen sich im Sitzungsverlauf fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea se cancela de todos modos. Las conversaciones se pueden reanudar desde el historial de sesiones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはどちらの場合も取り消されます。会話はセッション履歴から再開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论如何任务都会被取消。对话可以从会话历史中继续。"
          }
        }
      }
    },
