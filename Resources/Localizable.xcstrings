            "state": "translated",
            "value": ":%1$lld занят: %2$@ на экране %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ":%1$lld ist belegt: %2$@ auf %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ":%1$lld está ocupado: %2$@ en %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ":%1$lldは使用中です：%3$@の%2$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": ":%lld 已被占用：%@ 位于 %@。"
          }
        }
      }
    },
    "A finished or failed agent’s banner waits until you stop typing in Kelp for 20 seconds, then they come as one. Questions come at once.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баннер «закончил» или «ошибка» ждёт, пока вы 20 секунд не печатаете в Kelp, и потом приходит один на всех. Вопросы агентов приходят сразу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Banner eines fertigen oder fehlgeschlagenen Agenten wartet, bis Sie 20 Sekunden lang nicht in Kelp tippen; dann kommen sie gesammelt. Fragen kommen sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tira de un agente que termina o falla espera hasta que dejas de escribir en Kelp durante 20 segundos, y luego llegan todas juntas. Las preguntas llegan al momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了または失敗したエージェントのバナーは、Kelpで20秒間入力が止まるまで待ってから、まとめて表示されます。質問はすぐに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成或失败的智能体横幅会等你在 Kelp 中停止输入 20 秒后再一并显示。问题会立即显示。"
          }
        }
      }
    },
    "A language’s own value wins over the one for all files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение для языка важнее значения для всех файлов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert einer Sprache hat Vorrang vor dem für alle Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor propio de un lenguaje prevalece sobre el de todos los archivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語ごとの値が、すべてのファイル用の値より優先されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某种语言自己的值优先于适用于所有文件的值。"
          }
        }
      }
    },
    "A notification at this level, and again at 95%.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомление на этом уровне и ещё раз на 95%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung bei diesem Stand und erneut bei 95 %."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una notificación a este nivel y otra al 95%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレベルで通知し、95%でもう一度通知します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "达到此水平时通知，95% 时再次通知。"
          }
        }
      }
    },
    "A port on the host, or an address it can reach: 5432, db.internal:5432.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порт на хосте или адрес, который с него виден: 5432, db.internal:5432."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
