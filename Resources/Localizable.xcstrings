            "state": "translated",
            "value": "プロジェクトフォルダはまだ%@にあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目文件夹仍在 %@ 上。"
          }
        }
      }
    },
    "The project has no other git worktrees.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У проекта нет других git worktree."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt hat keine anderen Git-Worktrees."
