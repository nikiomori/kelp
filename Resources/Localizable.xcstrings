    "The file on disk is no longer text (another encoding, or binary). Keep Mine writes your version over it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл на диске больше не текст (другая кодировка или двоичный). «Оставить мою» запишет вашу версию поверх него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei auf der Festplatte ist kein Text mehr (andere Codierung oder binär). „Meine behalten“ überschreibt sie mit Ihrer Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del disco ya no es texto (otra codificación, o binario). «Conservar el mío» escribe tu versión encima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上のファイルがテキストではなくなりました（別のエンコーディング、またはバイナリ）。「自分の版を残す」を選ぶと、あなたの版で上書きします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘上的文件已不再是文本（编码不同，或为二进制）。“保留我的版本”会用你的版本覆盖它。"
          }
        }
      }
    },
