    "Continue working agents after a crash": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После сбоя продолжать работавших агентов"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Agenten nach einem Absturz fortsetzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar los agentes que trabajaban tras un fallo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュ後に作業中のエージェントを続行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "崩溃后继续工作中的智能体"
          }
        }
      }
    },
    "One by one, with a pause. Agents you paused yourself wait for you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одному, с паузой. Кого вы усыпили сами, ждут вас."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einer nach dem anderen, mit Pause. Agenten, die Sie selbst pausiert haben, warten auf Sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno a uno, con una pausa. Los agentes que pausaste tú te esperan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一つずつ、間隔を空けて続行します。自分で一時停止したエージェントはそのまま待機します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐个继续，中间有停顿。你自己暂停的智能体会等你处理。"
          }
        }
      }
    },
