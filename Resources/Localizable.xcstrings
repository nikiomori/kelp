        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Taste ist ausgeblendet. „Einstellungen › Fenster“ blendet sie wieder ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón está oculto. Ajustes › Ventana lo recupera."
          }
        },
