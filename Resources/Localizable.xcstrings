    "Kelp forgets what it kept to sign in. Connecting again asks for it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp забудет данные для входа. При новом подключении спросит их снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp vergisst die gespeicherten Anmeldedaten. Beim erneuten Verbinden werden sie wieder abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp olvidará los datos de inicio de sesión que guardó. Al volver a conectar, los pedirá de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはサインイン用に保存した情報を消去します。再接続するときにもう一度求められます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 会忘记为登录而保存的信息。再次连接时会重新询问。"
          }
        }
      }
    },
