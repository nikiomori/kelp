    "Restarts into an update after its turn, in the same conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапускается на новой версии после хода, в том же разговоре."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet nach seiner Runde mit einem Update neu, in derselben Unterhaltung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reinicia con una actualización tras su turno, en la misma conversación."
          }
        },
