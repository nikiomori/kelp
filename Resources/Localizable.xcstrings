            "value": "%@を信頼しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任 %@？"
          }
        }
      }
    },
    "Kelp hasn’t connected to it before. Its key is %@ (%@): trust it only if that’s the key you expect.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp ещё не подключался к нему. Его ключ — %@ (%@): доверяйте ему, только если это ожидаемый ключ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp war noch nie damit verbunden. Der Schlüssel ist %@ (%@): Nur vertrauen, wenn genau dieser Schlüssel erwartet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp no se ha conectado antes a él. Su clave es %@ (%@): confía en ella solo si es la clave que esperas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはまだこのサーバに接続したことがありません。鍵は%@（%@）です。想定どおりの鍵である場合のみ信頼してください。"
          }
        },
        "zh-Hans": {
