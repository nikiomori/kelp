    "%lld whole on this Mac, %lld without pictures, %lld with no copy.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целиком на этом Mac: %1$lld, без картинок: %2$lld, без копии: %3$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständig auf diesem Mac: %1$lld, ohne Bilder: %2$lld, ohne Kopie: %3$lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld completas en este Mac, %lld sin imágenes, %lld sin copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに完全保存%lld件、画像なし%lld件、コピーなし%lld件。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上完整的 %lld 个，无图片的 %lld 个，无副本的 %lld 个。"
          }
        }
      }
    },
