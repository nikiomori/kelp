    "“%@” moves by an animation that never ends: change it in its code.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» двигает бесконечная анимация: меняйте её в коде."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ bewegt sich durch eine Animation, die nie endet: im Code ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se mueve con una animación que nunca termina: cámbiala en su código."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は終わらないアニメーションで動いています。コードで変更してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
