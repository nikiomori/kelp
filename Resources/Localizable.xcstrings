    "They’re paused since %@. Agents you paused yourself aren’t affected.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они на паузе с %@. Агентов, которых вы усыпили сами, это не касается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind seit %@ pausiert. Agenten, die Sie selbst pausiert haben, sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están en pausa desde %@. Los agentes que pausaste tú no se ven afectados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から一時停止しています。自分で一時停止したエージェントには影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们自 %@ 起已暂停。你自己暂停的智能体不受影响。"
          }
        }
      }
    },
    "Continue All": {
      "localizations": {
        "ru": {
