          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们的会话将结束"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thema"
          }
        },
        "es": {
