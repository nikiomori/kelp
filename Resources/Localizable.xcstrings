    "The instruction files are saved: new chats read %@ tokens. A chat open now keeps what it read until it restarts.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы инструкций сохранены: новые чаты читают %@ токенов. Открытый сейчас чат помнит прочитанное до перезапуска."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anweisungsdateien sind gesichert: Neue Chats lesen %@ Tokens. Ein jetzt geöffneter Chat behält das Gelesene bis zum Neustart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de instrucciones se han guardado: los chats nuevos leen %@ tokens. Un chat abierto ahora conserva lo que leyó hasta que se reinicie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストラクションファイルを保存しました。新しいチャットは%@トークンを読み込みます。開いているチャットは再起動するまで読み込んだ内容を保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明文件已存储：新对话会读取 %@ token。当前打开的对话在重新启动前保留它已读取的内容。"
          }
        }
      }
    },
    "This chat read %@ when it started: new chats read %@. Restart it to read them too.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот чат при старте прочитал %1$@, новые чаты читают %2$@. Перезапустите его, чтобы он прочитал новое."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Chat hat beim Start %@ gelesen, neue Chats lesen %@. Zum Neueinlesen neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este chat leyó %1$@ al empezar: los chats nuevos leen %2$@. Reinícialo para que también los lea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは開始時に%1$@を読み込みました。新しいチャットは%2$@を読み込みます。再起動すると新しい内容を読み込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话启动时读取了 %@：新对话会读取 %@。重新启动它即可读取新内容。"
          }
        }
      }
    },
    "Can’t Reach the Server": {
      "localizations": {
