    "Trust it only if you know where this project comes from. Kelp asks again if the file changes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверяйте, только если знаете, откуда этот проект. Kelp спросит снова, если файл изменится."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur vertrauen, wenn Sie wissen, woher dieses Projekt stammt. Kelp fragt erneut, wenn sich die Datei ändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía solo si sabes de dónde viene este proyecto. Kelp vuelve a preguntar si el archivo cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトの出所がわかっている場合だけ信頼してください。ファイルが変更されると、Kelpは再度確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你知道此项目来源时才信任它。如果文件发生更改，Kelp 会再次询问。"
          }
        }
      }
    },
