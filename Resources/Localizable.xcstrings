    "Kelp uses the GitHub CLI and its login. Project boards need `gh auth refresh -s read:project`.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp использует GitHub CLI и его вход. Для досок проектов нужен `gh auth refresh -s read:project`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp verwendet die GitHub CLI und deren Anmeldung. Project-Boards benötigen `gh auth refresh -s read:project`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp usa la CLI de GitHub y su inicio de sesión. Los tableros de proyectos necesitan `gh auth refresh -s read:project`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "KelpはGitHub CLIとそのログイン情報を使用します。プロジェクトボードには`gh auth refresh -s read:project`が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 使用 GitHub CLI 及其登录信息。项目看板需要 `gh auth refresh -s read:project`。"
          }
        }
      }
    },
    "Kelp isn’t allowed to run in the background: quitting or updating it ends running agents.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp не разрешено работать в фоне: выход из него или обновление завершают запущенных агентов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp darf nicht im Hintergrund laufen: Beenden oder Aktualisieren beendet laufende Agenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp no tiene permiso para ejecutarse en segundo plano: al salir o actualizarlo, se detienen los agentes en ejecución."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはバックグラウンドでの実行を許可されていません：終了またはアップデートすると実行中のエージェントが停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 未被允许在后台运行：退出或更新它会结束正在运行的智能体。"
          }
        }
      }
    },
