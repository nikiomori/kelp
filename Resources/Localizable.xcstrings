    "Moved %@ aside on %@ (%@): .git/kelp-trash keeps it a week.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ отложено на %2$@ (%3$@): .git/kelp-trash хранит неделю."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ auf %2$@ beiseitegelegt (%3$@): .git/kelp-trash bewahrt es eine Woche auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha apartado %@ en %@ (%@): .git/kelp-trash lo guarda una semana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を%2$@に退避しました（%3$@）。.git/kelp-trashに1週間保管されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@ 移到 %@ 上的一旁（%@）：.git/kelp-trash 会保留一周。"
          }
        }
      }
    },
    "Moved %@ to the Trash (%@). Empty the Trash to free it.": {
      "localizations": {
