    "Couldn’t find that element in %@ as it is now: drawn again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти этот элемент в %@ в нынешнем виде: доска перерисована."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element wurde in %@ im aktuellen Zustand nicht gefunden: neu gezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ese elemento en %@ tal como está ahora: se ha vuelto a dibujar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の%@にその要素が見つかりませんでした。再描画しました。"
