    "Setting “%@”: Kelp has no type “%@”, so it shows as a text field.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка «%@»: в Kelp нет типа «%@», поэтому она показана текстовым полем."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellung „%@“: Kelp kennt den Typ „%@“ nicht, daher wird sie als Textfeld angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste «%@»: Kelp no tiene el tipo «%@», así que se muestra como campo de texto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定“%1$@”: Kelpには型“%2$@”がないため、テキストフィールドとして表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置“%@”：Kelp 没有类型“%@”，因此显示为文本栏。"
          }
        }
      }
    },
    "Setting “%@”: Kelp has no look “%@”, so it shows as a menu.": {
      "extractionState": "manual",
      "localizations": {
