            "state": "translated",
            "value": "データベースのコピー%@も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其数据库副本 %@ 也会一并删除。"
          }
        }
      }
    },
    "Files in the project are not touched.": {
      "localizations": {
        "ru": {
