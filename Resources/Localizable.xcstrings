    "Compact tabs are 24 pt in a 32 pt strip. Also in a tab’s right-click menu.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компактные вкладки — 24 pt в полосе 32 pt. Ещё есть в меню вкладки по правому клику."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompakte Tabs sind 24 pt hoch in einer 32-pt-Leiste. Auch im Kontextmenü eines Tabs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pestañas compactas miden 24 pt en una franja de 32 pt. También en el menú de clic derecho de una pestaña."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクトなタブは32 ptの帯の中で24 ptです。タブの右クリックメニューにもあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑标签页高 24 pt，位于 32 pt 的条带中。也可在标签页的右键菜单中设置。"
          }
        }
      }
    },
