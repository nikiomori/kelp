    "Take all %lld passwords now: macOS asks %lld times. Else once each, when you open it": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Взять все пароли (%1$lld) сейчас: macOS спросит %2$lld раз. Иначе по одному, когда откроете базу"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle %lld Passwörter jetzt übernehmen: macOS fragt %lld-mal. Sonst jeweils einmal beim Öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener ahora las %lld contraseñas: macOS pregunta %lld veces. Si no, una a una, al abrir cada base de datos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld個のパスワードを今すべて取得する（macOSが%2$lld回確認します）。しない場合は、開くときに1つずつ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
