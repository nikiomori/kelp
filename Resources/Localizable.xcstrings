          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push abgelehnt: Das Remote hat Commits, die diesem Branch fehlen. Zuerst pullen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Push rechazado: el remoto tiene commits que esta rama no tiene. Haz pull primero."
