    "Kelp isn’t allowed to run in the background, so macOS ends its agents when it quits.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp не разрешено работать в фоне, поэтому при выходе macOS завершит его агентов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp darf nicht im Hintergrund laufen, daher beendet macOS seine Agenten, wenn es beendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp no tiene permiso para ejecutarse en segundo plano, así que macOS detiene sus agentes al salir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはバックグラウンドでの実行を許可されていないため、終了するとmacOSがエージェントを停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 未被允许在后台运行，因此退出时 macOS 会结束它的智能体。"
          }
        }
      }
    },
    "Kelp needs to reopen for this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого Kelp нужно открыть заново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp muss dafür neu geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp tiene que volver a abrirse para esto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このためにはKelpを開き直す必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 需要为此重新打开。"
          }
        }
      }
    },
    "Kelp types “continue” here a minute after the reset, even with its window closed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp напечатает здесь «continue» через минуту после сброса, даже с закрытым окном."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp tippt hier eine Minute nach dem Zurücksetzen „continue“, auch wenn sein Fenster geschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp escribe «continue» aquí un minuto después del restablecimiento, aunque su ventana esté cerrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウを閉じていても、リセットの1分後にKelpがここに“continue”と入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置一分钟后，Kelp 会在这里输入“continue”，即使其窗口已关闭。"
          }
        }
      }
    },
