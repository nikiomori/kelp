          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie belegt keinen Arbeitsspeicher dieses Mac. Der nächste Befehl weckt sie in unter einer Sekunde, mit allem, was darin lief."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No ocupa nada de la memoria de este Mac. El siguiente comando la despierta en menos de un segundo, con todo lo que ejecutaba."
