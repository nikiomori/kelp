    "Pull requests, issues and CI runs show here once this project’s git has a remote on GitHub.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request’ы, issues и прогоны CI появятся здесь, когда у git этого проекта будет удалённый репозиторий на GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull Requests, Issues und CI-Läufe erscheinen hier, sobald das git dieses Projekts ein Remote auf GitHub hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pull requests, issues y ejecuciones de CI aparecen aquí cuando el git de este proyecto tiene un remoto en GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトのgitにGitHubのリモートがあれば、プルリクエスト、Issue、CIの実行がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目的 git 在 GitHub 上有远程仓库后，拉取请求、议题和 CI 运行会显示在这里。"
          }
        }
      }
    },
