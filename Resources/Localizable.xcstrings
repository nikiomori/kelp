    "No pages yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страниц пока нет"
          }
        }
      }
    },
    "Docs and reviews agents make for you list here. Ask for one with Make, on the start page or in +.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь будут документы и разборы, которые агенты делают для вас. Попросите их через «Сделать» на стартовой странице или в «+»."
          }
        }
      }
    },
    "%lld of %lld answered": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "отвечено %1$lld из %2$lld"
          }
        }
      }
    },
