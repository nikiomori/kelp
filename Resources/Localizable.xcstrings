          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにトークン数を保存していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在这台 Mac 上保存 token 计数"
          }
        }
      }
    },
    "Kelp connects when you ask: it doesn’t dial a machine by itself.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp подключается, когда вы просите: сам он к машинам не обращается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp verbindet sich nur auf Anfrage: Es wählt sich nie selbst bei einem Rechner ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp se conecta cuando se lo pides: no llama a ninguna máquina por su cuenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはあなたが頼んだときに接続します。勝手にマシンに接続することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 只在你要求时连接：不会自行连接机器。"
          }
        }
      }
    },
    "Kelp didn’t keep these rows as they were before the change.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp не сохранил эти строки такими, какими они были до изменения."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp hat diese Zeilen nicht im Zustand vor der Änderung gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp no guardó estas filas como estaban antes del cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはこれらの行の変更前の状態を保存していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 没有保留这些行在更改前的样子。"
          }
        }
      }
    },
    "Kelp has it already": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже есть в Kelp"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp hat es bereits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp ya la tiene"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpにすでにあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 中已有"
          }
        }
      }
    },
    "Kelp keeps the rows of the latest runs only.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp хранит строки только последних запусков."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp speichert nur die Zeilen der letzten Läufe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp solo guarda las filas de las últimas ejecuciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpは最新の実行の行のみ保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 只保留最近几次运行的行。"
          }
        }
      }
    },
    "Kelp looks in compose files, .env, config/database.yml, .idea and SQLite or DuckDB files of the project.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp ищет в файлах compose, .env, config/database.yml, .idea и в файлах SQLite и DuckDB проекта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp sucht in Compose-Dateien, .env, config/database.yml, .idea sowie SQLite- und DuckDB-Dateien des Projekts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp busca en los archivos compose, .env, config/database.yml, .idea y los archivos SQLite o DuckDB del proyecto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはプロジェクトのcomposeファイル、.env、config/database.yml、.idea、SQLiteやDuckDBファイルを探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 会查找项目中的 compose 文件、.env、config/database.yml、.idea 以及 SQLite 或 DuckDB 文件。"
          }
        }
      }
    },
    "Kelp no longer keeps this change’s rows: it keeps the latest changes only.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp больше не хранит строки этого изменения: он хранит только последние."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp speichert die Zeilen dieser Änderung nicht mehr: Es behält nur die letzten Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp ya no guarda las filas de este cambio: solo guarda los cambios más recientes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはこの変更の行をもう保存していません。最新の変更のみ保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 已不再保留此更改的行：它只保留最近的更改。"
          }
        }
      }
    },
    "Kelp puts back the rows of one table’s UPDATE, DELETE or INSERT when it kept them all as they were: not this change.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp возвращает строки после UPDATE, DELETE или INSERT одной таблицы, когда сохранил их все прежними. Это изменение не такое."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp stellt die Zeilen eines UPDATE, DELETE oder INSERT einer Tabelle wieder her, wenn es sie alle im vorherigen Zustand gespeichert hat: nicht bei dieser Änderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp restaura las filas de un UPDATE, DELETE o INSERT de una tabla cuando las guardó todas como estaban: no es el caso de este cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpが戻せるのは、1つのテーブルに対するUPDATE、DELETE、INSERTで、変更前の行をすべて保存できた場合です。この変更は該当しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Kelp 完整保留了单个表的 UPDATE、DELETE 或 INSERT 之前的所有行时，才能将其恢复：此更改不符合。"
          }
        }
      }
    },
    "Kept in the keychain": {
      "localizations": {
