      }
    },
    "%lld paused agents close for good. ": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты на паузе закроются насовсем: %lld. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pausierte Agenten werden endgültig geschlossen. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
