    "%@ stops being production: agents get what Agents says, %@, and their changes reach it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ перестанет быть Production: агенты получат то, что стоит в строке «Агенты» (%2$@), и их изменения дойдут до базы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nicht mehr Production: Agenten erhalten, was „Agenten“ vorgibt (%2$@), und ihre Änderungen erreichen die Datenbank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deja de ser Production: los agentes obtienen lo que indica Agentes, %2$@, y sus cambios le llegan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はProductionではなくなります。エージェントは「エージェント」の設定（%2$@）どおりに扱われ、その変更がデータベースに反映されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不再是生产环境：智能体获得“智能体”中设定的权限（%@），它们的更改会写入其中。"
          }
        }
      }
    },
