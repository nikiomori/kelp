          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent hat sie geschrieben, um die Zahlen zu lesen. Kelp führt sie ab jetzt bei „Aktualisieren“ aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su agente los escribió para leer sus cifras. A partir de ahora Kelp los ejecuta al pulsar «Actualizar»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数値を読み取るためにエージェントが書いたコマンドです。今後は「更新」のたびにKelpが実行します。"
