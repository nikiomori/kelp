    "%@ goes back to the committed lines here: %lld added lines go, %lld removed lines come back. This can’t be undone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ вернётся к закоммиченным строкам: добавленных строк уйдёт — %2$lld, удалённых вернётся — %3$lld. Это нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kehrt hier zu den committeten Zeilen zurück: %2$lld hinzugefügte Zeilen verschwinden, %3$lld entfernte Zeilen kommen zurück. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve aquí a las líneas con commit: se quitan %lld líneas añadidas y vuelven %lld líneas eliminadas. Esta acción no se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はここでコミット済みの行に戻ります：追加した%2$lld行は削除され、削除した%3$lld行は戻ります。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将恢复为这里已提交的行：添加的 %lld 行会被删除，删除的 %lld 行会恢复。此操作无法撤销。"
          }
        }
      }
    },
