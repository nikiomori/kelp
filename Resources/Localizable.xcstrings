{
  "sourceLanguage": "en",
  "strings": {
    "%@ asks you": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ спрашивает вас"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fragt Sie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te pregunta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が質問しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在问你"
          }
        }
      }
    },
    "%@ can't go back: %@ The files still can.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не вернуть: %2$@ Файлы вернуть можно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lässt sich nicht zurücksetzen: %2$@ Die Dateien schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede volver atrás: %@ Los archivos todavía sí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は元に戻せません：%@ ファイルは引き続き戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法回退：%2$@ 文件仍可回退。"
          }
        }
      }
    },
