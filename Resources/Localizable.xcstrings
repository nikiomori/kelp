    "A tick on the bar: how much would be used by now, spending evenly until the reset.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черточка на полосе: сколько было бы потрачено к этому времени при ровном расходе до сброса."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Strich auf dem Balken: wie viel bis jetzt verbraucht wäre, bei gleichmäßigem Verbrauch bis zum Zurücksetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una marca en la barra: cuánto se habría usado ya gastando de forma uniforme hasta el reinicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バー上の目盛りです。リセットまで均等に使った場合、現時点でどれだけ使っているはずかを示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度条上的刻度：若匀速使用到重置，此时应已用多少。"
          }
        }
      }
    },
    "Only when it resets within 12 hours.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда сброс в ближайшие 12 часов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn das Zurücksetzen innerhalb von 12 Stunden erfolgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuando se reinicia en menos de 12 horas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12時間以内にリセットされる場合のみ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当在 12 小时内重置时。"
          }
        }
      }
    },
