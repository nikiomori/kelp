    "Level with the tabs or under the panel. Drag an icon to move it; right-click the icons to hide them.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На одной линии с вкладками или под панелью. Значок можно перетащить; правый щелчок по значкам скрывает их."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Höhe der Tabs oder unter dem Panel. Ein Symbol ziehen, um es zu bewegen; Rechtsklick auf die Symbole, um sie auszublenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la altura de las pestañas o bajo el panel. Arrastra un icono para moverlo; haz clic derecho en los iconos para ocultarlos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブと同じ高さ、またはパネルの下。アイコンをドラッグすると移動でき、右クリックすると非表示にできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与标签页平齐或在面板下方。拖移图标以移动它；右键点按图标可隐藏它们。"
          }
        }
      }
    },
