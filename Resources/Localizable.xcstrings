    "Agents ask you before each change.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты спрашивают вас перед каждым изменением."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten fragen vor jeder Änderung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes te preguntan antes de cada cambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは変更のたびに確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次更改前，智能体都会询问你。"
          }
        }
      }
    },
    "Agents don’t see it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты её не видят."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten sehen sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes no la ven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントからは見えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体看不到它。"
          }
        }
      }
    },
    "Agents don’t see them until you choose Use in a project from a database’s menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты не видят их, пока вы не выберете в меню базы «Использовать в проекте»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten sehen sie erst, wenn im Menü einer Datenbank „In einem Projekt verwenden“ gewählt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes no las ven hasta que eliges «Usar en un proyecto» en el menú de una base de datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースのメニューで「プロジェクトで使用」を選ぶまで、エージェントからは見えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在数据库菜单中选择“在项目中使用”之前，智能体看不到它们。"
          }
        }
      }
    },
    "Agents here see no database yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты здесь пока не видят ни одной базы"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten sehen hier noch keine Datenbank"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí los agentes aún no ven ninguna base de datos"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここのエージェントにはまだデータベースが見えていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的智能体还看不到任何数据库"
          }
        }
      }
    },
    "Agents only read it. Your saves show their SQL and ask first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты её только читают. Перед вашим сохранением Kelp покажет SQL и спросит."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten lesen sie nur. Eigene Sicherungen zeigen ihr SQL und fragen zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes solo la leen. Tus guardados muestran su SQL y preguntan primero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは読み取りのみです。あなたが保存するときは、SQLを表示して確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体只读取它。你的存储操作会显示其 SQL 并先询问。"
          }
        }
      }
    },
    "Agents read and change it without asking.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты читают и изменяют её без вопросов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten lesen und ändern sie ohne Rückfrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes la leen y la cambian sin preguntar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは確認なしで読み取りと変更ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体无需询问即可读取和更改它。"
          }
        }
      }
    },
    "Agents read it; a change is refused.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты её читают; изменения отклоняются."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten lesen sie; Änderungen werden abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes la leen; los cambios se rechazan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは読み取れます。変更は拒否されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体可读取它；更改会被拒绝。"
          }
        }
      }
    },
    "Agents read it; each change waits for your Allow.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты её читают; каждое изменение ждёт вашего «Разрешить»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten lesen sie; jede Änderung wartet auf „Erlauben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los agentes la leen; cada cambio espera tu «Permitir»."
          }
        },
        "ja": {
