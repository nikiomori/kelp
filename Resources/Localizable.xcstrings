    "A ring while it runs, ✕ when it fails, ◎ while a deploy waits for approval, ✓ for a minute after it passes.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кольцо, пока идёт, ✕ — если упал, ◎ — пока деплой ждёт подтверждения, ✓ — минуту после успеха."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ring, solange er läuft, ✕, wenn er fehlschlägt, ◎, solange ein Deployment auf Freigabe wartet, ✓ für eine Minute nach dem Bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un anillo mientras se ejecuta, ✕ si falla, ◎ mientras un despliegue espera aprobación, ✓ durante un minuto tras superarse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中はリング、失敗すると✕、デプロイが承認待ちの間は◎、合格後1分間は✓を表示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行时显示圆环，失败时显示 ✕，部署等待批准时显示 ◎，通过后的一分钟内显示 ✓。"
          }
        }
      }
    },
