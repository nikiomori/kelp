    "Every 5 minutes while Kelp is in front.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждые 5 минут, пока Kelp на переднем плане."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 5 Minuten, während Kelp im Vordergrund ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 5 minutos mientras Kelp está en primer plano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpが前面にある間、5分ごと。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 在前台时每 5 分钟一次。"
          }
        }
      }
    },
    "Every 5 minutes while Kelp is in front, and at once when you come back to it, for the projects in the sidebar. Never asks for a password.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждые 5 минут, пока Kelp на переднем плане, и сразу, когда вы к нему возвращаетесь, для проектов в боковой панели. Никогда не спрашивает пароль."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 5 Minuten, während Kelp im Vordergrund ist, und sofort bei der Rückkehr, für die Projekte in der Seitenleiste. Fragt nie nach einem Passwort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 5 minutos mientras Kelp está en primer plano, y al momento cuando vuelves a él, para los proyectos de la barra lateral. Nunca pide contraseña."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpが前面にある間は5分ごと、またKelpに戻ったときにすぐ、サイドバーのプロジェクトを対象に実行します。パスワードを求めることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 在前台时每 5 分钟一次，回到 Kelp 时也立即进行，针对边栏中的项目。从不要求输入密码。"
          }
        }
      }
    },
