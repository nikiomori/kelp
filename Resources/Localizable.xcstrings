            "value": "El proyecto no tiene otros worktrees de git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトにはほかのGitワークツリーがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目没有其他 git 工作树。"
          }
        }
      }
    },
    "The repository on disk is not touched.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий на диске не затрагивается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository auf der Festplatte bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio en el disco no se toca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上のリポジトリには影響しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘上的仓库不受影响。"
          }
        }
      }
    },
    "The same failed on attempt %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На попытке %lld упало то же."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe ist bei Versuch %lld fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo mismo falló en el intento %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行%lldでも同じ失敗が発生しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 次尝试时同样失败。"
          }
        }
      }
    },
    "The shortcuts you set are lost.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заданные вами сочетания пропадут."
          }
        },
