    "Pages agents make show here, from every project.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются страницы, которые делают агенты, из всех проектов."
          }
        }
      }
    },
    "Pages moved to the archive leave the other lists, and come back from here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы в архиве уходят из других списков и возвращаются отсюда."
          }
        }
      }
    },
    "Pin": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепить"
          }
        }
      }
    },
    "Pin a page from its menu to keep it on top.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепите страницу в её меню, чтобы она была наверху."
