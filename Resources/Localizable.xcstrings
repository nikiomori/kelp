    "%@ kept changing as you edited it, so that change isn’t written: drawn again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ менялся, пока вы правили, поэтому правка не записана: показано заново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sich während der Bearbeitung ständig geändert, daher wurde die Änderung nicht geschrieben: neu gezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ siguió cambiando mientras lo editabas, así que ese cambio no se ha escrito: se ha vuelto a dibujar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中に%@が変化し続けたため、その変更は書き込まれていません。再描画しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你编辑时不断变化，因此该更改未写入：已重新绘制。"
          }
        }
      }
    },
