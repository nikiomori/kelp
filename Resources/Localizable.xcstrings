    "%@\nAn agent’s page: cookies and storage of its own": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nСтраница агента: свои куки и хранилище"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nSeite eines Agenten: eigene Cookies und eigener Speicher"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nLa página de un agente: cookies y almacenamiento propios"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nエージェントのページ: 専用のCookieとストレージ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n智能体的页面：拥有自己的 Cookie 和存储"
          }
        }
      }
    },
    "%@ is writing the first one into boards/. Each board shows as it’s saved.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ пишет первую в boards/. Каждая доска появится, как только сохранится."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schreibt das erste in boards/. Jedes Board erscheint, sobald es gesichert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está escribiendo el primero en boards/. Cada tablero aparece en cuanto se guarda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が最初のボードをboards/に書いています。各ボードは保存されると表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在将第一块画板写入 boards/。每块画板存储后即会显示。"
          }
        }
      }
    },
