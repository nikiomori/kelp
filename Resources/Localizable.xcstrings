    "1 paused agent closes for good. ": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 агент на паузе закроется насовсем. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 pausierter Agent wird endgültig geschlossen. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 agente en pausa se cierra definitivamente. "
          }
        },
