    "Its password is read from the app it came from when you open it: macOS asks once.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль читается из приложения, откуда база пришла, когда вы её открываете: macOS спросит один раз."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort wird beim Öffnen aus der App gelesen, aus der es stammt: macOS fragt einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su contraseña se lee de la app de la que vino cuando la abres: macOS pregunta una vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードは、開くときに取得元のアプリから読み取ります。macOSが1回確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开时会从其来源 App 读取密码：macOS 会询问一次。"
          }
        }
      }
    },
    "Keep in": {
      "localizations": {
