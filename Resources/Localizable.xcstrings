    "You said Don’t Allow: the rest came without passwords, and ask when opened.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выбрали «Не разрешать»: остальные пришли без паролей и спросят их при открытии."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Nicht erlauben“ gewählt: Die übrigen kamen ohne Passwörter und fragen beim Öffnen danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegiste «No permitir»: las demás llegaron sin contraseña y la piden al abrirlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「許可しない」を選びました。残りはパスワードなしで追加され、開くときに確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择了“不允许”：其余项目导入时未带密码，打开时会询问。"
          }
        }
      }
    },
