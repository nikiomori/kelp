    "Takes effect the next time Kelp opens.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применится при следующем запуске Kelp."
          }
        }
      }
    },
    "Task list": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список задач"
          }
        }
      }
    },
    "Team: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда: %@"
          }
        }
      }
    },
    "Terminal": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал"
          }
        }
      }
    },
    "Terminal opacity": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрозрачность терминала"
          }
        }
      }
    },
    "Test": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тест"
          }
        }
      }
    },
    "Test at Cursor": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тест под курсором"
          }
        }
      }
    },
    "Tests": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тесты"
          }
        }
      }
    },
    "Text": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст"
          }
        }
      }
    },
    "The agent ended before it finished": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент закончил, не доделав"
          }
        }
      }
    },
    "The agent is still working. Closing the tab ends its session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент ещё работает. Закрытие вкладки завершит его сессию."
          }
        }
      }
    },
    "The agent’s default": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как у агента по умолчанию"
          }
        }
      }
    },
    "The background service is still the previous version. Restart it to finish the update — running agent sessions will end. You can also do it later from the Kelp menu.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба ещё старой версии. Перезапустите её, чтобы закончить обновление, — сессии агентов завершатся. Это можно сделать и позже из меню Kelp."
          }
        }
      }
    },
    "The browser, git and issues are extensions too. Turn off what you don’t use.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браузер, git и задачи — тоже расширения. Выключите то, чем не пользуетесь."
          }
        }
      }
    },
    "The button is hidden. Settings › Appearance brings it back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка скрыта. Вернуть можно в Настройки › Appearance."
          }
        }
      }
    },
    "The checkout and branch %@ are removed. Running agents stop.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout и ветка %@ удаляются. Запущенные агенты остановятся."
          }
        }
      }
    },
    "The commands bar is hidden. Settings › Agents brings it back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полоса команд скрыта. Вернуть можно в Настройки › Agents."
          }
        }
      }
    },
    "The connection to the host dropped. %@ keeps running there.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь с хостом прервалась. %@ продолжает работать там."
          }
        }
      }
    },
    "The extension that shows “%@” is turned off or was removed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение, которое показывает «%@», выключено или удалено."
          }
        }
      }
    },
    "The file’s folders and the scopes around the cursor, in a thin bar over the editor.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки файла и области вокруг курсора в тонкой полосе над редактором."
          }
        }
      }
    },
    "The language server can’t rename this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковой сервер не может это переименовать."
          }
        }
      }
    },
    "The lines that open the class and function you’re in stay pinned as you scroll.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строки, открывающие текущий класс и функцию, остаются вверху при прокрутке."
          }
        }
      }
    },
    "The Mac can sleep. Click to keep it awake": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac может уснуть. Нажмите, чтобы не давать ему засыпать"
          }
        }
      }
    },
    "The Mac stays awake until you click here": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не уснёт, пока вы не нажмёте здесь"
          }
        }
      }
    },
    "The Mac stays awake while agents work. Click to keep it awake always": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не уснёт, пока работают агенты. Нажмите, чтобы он не засыпал совсем"
          }
        }
      }
    },
    "The Mac was asleep or Kelp wasn’t running. Run Now is on its Routines tab.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac спал или Kelp не был запущен. «Запустить сейчас» — на вкладке «Рутины»."
          }
        }
      }
    },
    "The newest run of each workflow; a click opens CI Runs.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний запуск каждого workflow; щелчок открывает CI Runs."
          }
        }
      }
    },
    "The project folder is still on %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка проекта всё ещё на %@."
          }
        }
      }
    },
    "The project has no other git worktrees.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У проекта нет других git worktree."
          }
        }
      }
    },
    "The repository on disk is not touched.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Репозиторий на диске не затрагивается."
          }
        }
      }
    },
    "The same failed on attempt %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На попытке %lld упало то же."
          }
        }
      }
    },
    "The shortcuts you set are lost.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заданные вами сочетания пропадут."
          }
        }
      }
    },
    "The terminal and the editor have their own font sizes.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У терминала и редактора свои размеры шрифта."
          }
        }
      }
    },
    "The window, terminal and editor together. Match System switches Kelp Light / Dark with macOS; Ghostty keeps your Ghostty terminal colors.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно, терминал и редактор вместе. «Как в системе» переключает Kelp Light / Dark вместе с macOS; Ghostty оставляет цвета вашего терминала Ghostty."
          }
        }
      }
    },
    "The work so far stays in this tab.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделанное остаётся в этой вкладке."
          }
        }
      }
    },
    "Their sessions end": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Их сессии завершатся"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема"
          }
        }
      }
    },
    "Themes for the window, terminal and editor.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Темы окна, терминала и редактора."
          }
        }
      }
    },
    "They keep running when Kelp quits or updates, on the host for a remote project. Closing the tab ends them. Needs tmux.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они работают дальше, когда Kelp закрывается или обновляется, у удалённого проекта — на хосте. Закрытие вкладки завершает их. Нужен tmux."
          }
        }
      }
    },
    "Thin lines at these columns, e.g. “80, 120”.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкие линии на этих колонках, например «80, 120»."
          }
        }
      }
    },
    "This can’t be undone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это нельзя отменить."
          }
        }
      }
    },
    "This folder isn’t under git version control.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка не под контролем git."
          }
        }
      }
    },
    "This is how you’ll hear that an agent finished or needs you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так вы узнаете, что агент закончил или ждёт вас."
          }
        }
      }
    },
    "This project has no “%@” command. Add one to .kelp.yaml (%@: the command).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This project has no “%1$@” command. Add one to .kelp.yaml (%2$@: the command)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого проекта нет команды «%@». Добавьте её в .kelp.yaml (%@: команда)."
          }
        }
      }
    },
    "Through the GitLab CLI (glab) and its login, self-managed hosts too.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через GitLab CLI (glab) и его вход, в том числе на своих серверах."
          }
        }
      }
    },
    "Through the GitHub CLI and its login. Project boards need `gh auth refresh -s read:project`.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через GitHub CLI и его вход. Для досок проектов нужен `gh auth refresh -s read:project`."
          }
        }
      }
    },
    "To add one, install it from the Library, or ask Claude Code in an agent tab, e.g. “make a Kelp panel that lists my Docker containers”. ": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить расширение, установите его из библиотеки или попросите Claude Code во вкладке агента, например: «сделай панель Kelp со списком моих Docker-контейнеров». "
          }
        }
      }
    },
    "To pull": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К получению"
          }
        }
      }
    },
    "Too big to open here (%@). Open it with another app.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл слишком большой, чтобы открыть его здесь (%@). Откройте его в другой программе."
          }
        }
      }
    },
    "Tools": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты"
          }
        }
      }
    },
    "Trim trailing whitespace on save": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирать пробелы в конце строк при сохранении"
          }
        }
      }
    },
    "Trust and Run": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверять и выполнить"
          }
        }
      }
    },
    "Trust": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверять"
          }
        }
      }
    },
    "Trust it only if you know where this project comes from. Kelp asks again if the file changes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверяйте, только если знаете, откуда этот проект. Kelp спросит снова, если файл изменится."
          }
        }
      }
    },
    "Turn Off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить"
          }
        }
      }
    },
    "Turn off what you don’t use. Always on: %@.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите то, чем не пользуетесь. Всегда включены: %@."
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить"
          }
        }
      }
    },
    "Turn on an extension in Settings › Extensions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите расширение в Настройках › Расширения."
          }
        }
      }
    },
    "Turned Off": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        }
      }
    },
    "Turned off for Kelp in System Settings › Notifications.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключены для Kelp в Системные настройки › Уведомления."
          }
        }
      }
    },
    "Turns shorter than the time below stay quiet.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ходы короче времени ниже проходят тихо."
          }
        }
      }
    },
    "Type a line number": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите номер строки"
          }
        }
      }
    },
    "Type a name": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя"
          }
        }
      }
    },
    "Type shortcut…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите сочетание…"
          }
        }
      }
    },
    "Under 100% the desktop shows through the terminals, and through the window around them, in any theme.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже 100% сквозь терминалы и окно вокруг них виден рабочий стол, в любой теме."
          }
        }
      }
    },
    "Underline": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подчёркивание"
          }
        }
      }
    },
    "Unmute": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить"
          }
        }
      }
    },
    "Unmute Notifications": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить уведомления"
          }
        }
      }
    },
    "Until I Unmute": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока не включу"
          }
        }
      }
    },
    "Unusual spaces, such as no-break ones, always show.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необычные пробелы, например неразрывные, видны всегда."
          }
        }
      }
    },
    "Update Anyway": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё равно обновить"
          }
        }
      }
    },
    "Update Kelp": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить Kelp"
          }
        }
      }
    },
    "Update Kelp to %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить Kelp до %@"
          }
        }
      }
    },
    "Updating ends running agents": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление завершит работающих агентов"
