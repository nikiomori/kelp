    "%@ opens read only: it’s too large, or its lines too long, to edit here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ открыт только для чтения: файл слишком большой или в нём слишком длинные строки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird schreibgeschützt geöffnet: Die Datei ist zu groß oder ihre Zeilen sind zu lang, um sie hier zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se abre en modo de solo lectura: es demasiado grande, o sus líneas demasiado largas, para editarlo aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は読み取り専用で開きます：大きすぎるか、行が長すぎるため、ここでは編集できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 以只读方式打开：它太大，或行太长，无法在这里编辑。"
          }
        }
      }
    },
    "%@ was moved or deleted. %@ asks before writing it there again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ перемещён или удалён. %2$@ спросит, прежде чем записать его туда снова."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde verschoben oder gelöscht. %2$@ fragt, bevor es dort erneut geschrieben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
