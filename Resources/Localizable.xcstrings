    "How the color from a project’s row menu shows. On the icon it also follows the project to the title bar, ⌃Tab and Needs You.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как показывать цвет из меню строки проекта. На иконке он виден и в заголовке окна, в ⌃Tab и в «Ждут вас»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie die Farbe aus dem Zeilenmenü eines Projekts erscheint. Auf dem Symbol folgt sie dem Projekt auch in die Titelleiste, zu ⌃Tab und „Wartet auf Sie“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se muestra el color del menú de la fila de un proyecto. En el icono también sigue al proyecto en la barra de título, ⌃Tab y «Te necesitan»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトの行メニューで選んだカラーの表示方法です。アイコンに表示する場合、タイトルバー、⌃Tab、「対応待ち」にも表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目行菜单中所选颜色的显示方式。显示在图标上时，它还会随项目出现在标题栏、⌃Tab 和“需要你”中。"
          }
        }
      }
    },
    "“%@” has work that’s nowhere else": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «%@» есть работа, которой больше нигде нет"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ enthält Arbeit, die es nirgendwo sonst gibt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tiene trabajo que no está en ningún otro sitio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”にはほかのどこにもない作業があります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”中有别处没有的工作"
          }
        }
      }
    },
    "Archive keeps it, agents paused, until Window › Archived Groups brings it back.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архив сохранит её и приостановит агентов, вернуть — Окно › Архивные группы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Archivieren“ behält sie mit pausierten Agenten, bis „Fenster › Archivierte Gruppen“ sie zurückholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar lo conserva, con los agentes en pausa, hasta que Ventana › Grupos archivados lo recupere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブすると作業を残したままエージェントを一時停止します。「ウインドウ › アーカイブ済みのグループ」で戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档会保留它并暂停智能体，直到通过“窗口 › 已归档的组”将其恢复。"
          }
        }
      }
    },
    "“%@” stays: its work is only on %@. %@ closes it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» остаётся: эта работа есть только на %2$@. Закрыть: %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ bleibt: Die Arbeit liegt nur auf %@. %@ schließt sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se queda: su trabajo solo está en %2$@. %3$@ lo cierra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”は残ります。この作業は%2$@にしかありません。閉じるには%3$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”保留：其工作只在 %@ 上。%@ 会关闭它。"
          }
        }
      }
    },
    "%lld agents they started end too.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запущенные агенты тоже завершатся: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von ihnen gestartete Agenten werden ebenfalls beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También terminarán %lld agentes que iniciaron."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動したエージェント%lld個も終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们启动的 %lld 个智能体也会结束。"
          }
        }
      }
    },
    "Closing the tab ends its session.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытие вкладки завершит его сессию."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schließen des Tabs beendet seine Sitzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la pestaña termina su sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タブを閉じるとセッションが終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭标签页会结束其会话。"
          }
        }
      }
    },
    "Report back to the parent agent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отчёт агенту, который запустил"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An den übergeordneten Agenten melden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informar al agente que lo inició"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "親エージェントに報告"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向父智能体报告"
          }
        }
      }
    },
    "When an agent starts another with kelp, the other’s result or question comes to it as input.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда агент запускает другого через kelp, результат или вопрос второго приходит первому во ввод."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Agent mit kelp einen anderen startet, erhält er dessen Ergebnis oder Frage als Eingabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un agente inicia otro con kelp, el resultado o la pregunta del otro le llega como entrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがkelpで別のエージェントを起動すると、その結果や質問が入力として届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当一个智能体用 kelp 启动另一个智能体时，另一个智能体的结果或问题会作为输入返回给它。"
          }
        }
      }
    },
    "Add routines": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлять рутины"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routinen hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
