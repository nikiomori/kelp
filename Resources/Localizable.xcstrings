    "“%@” would run a command or an agent from its data; it opens links and files only.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» запустил бы команду или агента из своих данных; это действие открывает только ссылки и файлы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ würde einen Befehl oder Agenten aus seinen Daten ausführen; es öffnet nur Links und Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ejecutaría un comando o un agente a partir de sus datos; solo abre enlaces y archivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はデータからコマンドやエージェントを実行しようとしています。開けるのはリンクとファイルだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”会根据其数据运行命令或智能体；它只打开链接和文件。"
