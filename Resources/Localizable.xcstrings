    "Each line is a subtitle. They share the work area, or the rest from the time shown, by length.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка — субтитр. Они делят рабочую область или время от указателя до конца по длине строк."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile ist ein Untertitel. Sie teilen sich den Arbeitsbereich oder den Rest ab der angezeigten Zeit, nach Länge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea es un subtítulo. Se reparten el área de trabajo, o el resto desde el tiempo mostrado, según su longitud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行が1つの字幕になります。作業範囲、または表示中の時刻から最後までを、行の長さに応じて分け合います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条字幕。它们按长度分配工作区域，或从当前时间起的剩余部分。"
          }
        }
      }
    },
