    "Only on %@: commits no other branch or remote has, and files not committed. Closing it asks first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только на %@: коммиты, которых нет ни в одной другой ветке и ни на одном сервере, и незакоммиченные файлы. При закрытии Kelp спросит."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf %@: Commits, die kein anderer Branch und kein Remote hat, und nicht committete Dateien. Vor dem Schließen wird gefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en %@: commits que no tiene ninguna otra rama ni remoto, y archivos sin commit. Al cerrarlo se pregunta primero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にしかないもの: ほかのブランチやリモートにないコミットと、コミットされていないファイル。閉じるときに確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 %@ 上：有其他分支或远程仓库都没有的提交，以及未提交的文件。关闭前会先询问。"
          }
        }
      }
    },
