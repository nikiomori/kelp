    "Its disk and everything on it (%@) are erased. This can’t be undone.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Её диск и всё, что на нём (%@), будет стёрто. Это нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Festplatte und alles darauf (%@) werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su disco y todo lo que contiene (%@) se borran. Esta acción no se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクとその内容（%@）がすべて消去されます。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其磁盘及上面的所有内容（%@）将被抹掉。此操作无法撤销。"
          }
        }
      }
    },
    "Its disk and everything on it are erased. This can’t be undone.": {
      "localizations": {
