    "%@’s new terminals and agents start in its dev container.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые терминалы и агенты проекта %@ запускаются в его dev container."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
