    "Pages agents make show here, from every project.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются страницы, которые делают агенты, из всех проектов."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten, die Agenten erstellen, erscheinen hier – aus allen Projekten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las páginas que crean los agentes, de todos los proyectos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが作成したページが、すべてのプロジェクトからここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体制作的页面会显示在这里，来自所有项目。"
          }
        }
      }
    },
    "Pages moved to the archive leave the other lists, and come back from here.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы в архиве уходят из других списков и возвращаются отсюда."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Seiten verschwinden aus den anderen Listen und kommen von hier zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas que se mueven al archivo salen de las demás listas y vuelven desde aquí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブに移動したページはほかのリストから消え、ここから戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到归档的页面会离开其他列表，可在这里移回。"
          }
        }
      }
    },
