            "value": "Te pregunta en su página: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のページであなたに質問しています: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在自己的页面上问你：%@"
          }
        }
