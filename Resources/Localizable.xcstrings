    "Pace Mark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка темпа"
          }
        }
      }
    },
    "Even pace mark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка ровного темпа"
          }
        }
      }
    },
    "A tick on the bar: how much would be used by now, spending evenly until the reset.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Черточка на полосе: сколько было бы потрачено к этому времени при ровном расходе до сброса."
          }
        }
      }
    },
    "Only when it resets within 12 hours.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только когда сброс в ближайшие 12 часов."
          }
        }
      }
    },
    "Even pace %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ровный темп %@"
          }
        }
      }
    },
    "%@: %lld %% of the %@ limit left": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: осталось %2$lld %% лимита «%3$@»"
          }
        }
      }
    },
    "Resets %@. What isn't used by then is lost.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сброс %@. Что не использовано к этому времени, сгорит."
          }
        }
      }
    },
    "Over half left; what isn't used by the reset is lost.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось больше половины; что не использовано к сбросу, сгорит."
