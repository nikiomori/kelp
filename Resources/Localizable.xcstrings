    "When an agent needs you": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда агент ждёт вас"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Agent Sie braucht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un agente te necesita"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
