    "It’s a draft: mark it ready for review first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это черновик: сначала отметьте его готовым к ревью."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Entwurf: zuerst als bereit zur Prüfung markieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un borrador: márcalo primero como listo para revisión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは下書きです。まずレビュー可能としてマークしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是草稿：请先将其标记为可供审查。"
          }
        }
      }
    },
    "Kelp can’t read the accounts in settings.json: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp не может прочитать аккаунты в settings.json: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp kann die Konten in settings.json nicht lesen: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp no puede leer las cuentas de settings.json: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpはsettings.json内のアカウントを読み込めません: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 无法读取 settings.json 中的账户：%@"
          }
        }
      }
    },
    "Kelp’s background service isn’t answering.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновая служба Kelp не отвечает."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst von Kelp antwortet nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano de Kelp no responde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelpのバックグラウンドサービスが応答しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelp 的后台服务没有响应。"
          }
        }
      }
    },
    "Mark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пометки"
          }
        },
        "de": {
          "stringUnit": {
